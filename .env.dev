# Dev. Loaded when APP_ENV is unset, dev, or development.
# Local secrets can override this from the gitignored file backend/.env.
# Start: uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload

APP_NAME=Expense Tracker API
APP_ENV=dev
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Local-only secret. Do not reuse this value in staging or prod.
JWT_SECRET=dev_only_jwt_secret_change_me_not_for_deploy_0001
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me_not_for_deploy_0001
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

DATABASE_URL=sqlite:///./expenses.db

# Flutter web uses a random localhost port, so dev allows any origin.
CORS_ORIGINS=*

# New-user defaults. Change DEFAULT_CURRENCY to switch the app currency.
DEFAULT_CURRENCY=INR
SUPPORTED_CURRENCIES=INR,USD,EUR,GBP
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ta
DEFAULT_THEME_MODE=light
DEFAULT_THEME_COLOR=purple
DEFAULT_OPENING_BALANCE=0.00

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@expensetracker.local

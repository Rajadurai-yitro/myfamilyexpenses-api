# Prod. Loaded when APP_ENV=prod or APP_ENV=production.
# Set the real values in the host (Render). They override this file.
# The app refuses to start while JWT or DATABASE_URL are still placeholders.
# Start: APP_ENV=prod uvicorn app.main:app --host 0.0.0.0 --port $PORT

APP_NAME=Expense Tracker API
APP_ENV=prod
DEBUG=False
PORT=8000
HOST=0.0.0.0

JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-another-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres

CORS_ORIGINS=https://expense-tracker.web.app

DEFAULT_CURRENCY=INR
SUPPORTED_CURRENCIES=INR,USD,EUR,GBP
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ta
DEFAULT_THEME_MODE=light
DEFAULT_THEME_COLOR=purple
DEFAULT_OPENING_BALANCE=0.00

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@expensetracker.local

# Template only. The API does not load this file.
# Shared config lives in:
#   .env.dev       local (default)
#   .env.staging   APP_ENV=staging
#   .env.prod      APP_ENV=prod
# Real staging/prod secrets go in the host environment, or in gitignored .env.

APP_NAME=Expense Tracker API
APP_ENV=dev
DEBUG=True
PORT=8000
HOST=0.0.0.0

JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-another-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

DATABASE_URL=sqlite:///./expenses.db
CORS_ORIGINS=*

DEFAULT_CURRENCY=INR
SUPPORTED_CURRENCIES=INR,USD,EUR,GBP
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ta
DEFAULT_THEME_MODE=light
DEFAULT_THEME_COLOR=purple
DEFAULT_OPENING_BALANCE=0.00

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@expensetracker.local
